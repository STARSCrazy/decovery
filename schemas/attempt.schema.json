{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cache/attempts/<address-key>.jsonl (one JSON object per line)",
  "type": "object",
  "required": [
    "schema", "time", "address", "name", "origin", "profile", "flags",
    "body_hash", "context_hash", "original_hash", "result"
  ],
  "properties": {
    "schema": { "const": 1 },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "RFC 3339 UTC, to the second" },
    "address": { "type": "string" },
    "name": { "type": "string" },
    "file": { "type": "string" },
    "origin": { "enum": ["build", "variant", "function", "search", "bench", "migrate"] },
    "label": { "type": "string" },
    "actor": { "type": "string", "description": "cli | mcp | bench-harness | bench:<run-id> | migrate" },
    "profile": { "type": "string" },
    "flags": { "type": "string" },
    "body_hash": { "type": "string", "pattern": "^[a-z0-9-]+:[0-9a-f]+$", "description": "<algo>:<hex> of the definition text, LF line ends; native records write blake3:<hex>, migrated ones keep their source algorithm (decomp-sha256:...)" },
    "context_hash": { "type": "string", "description": "blake3 hex over the rest of the file, the headers and the tool fingerprint" },
    "original_hash": { "type": "string", "description": "blake3 hex of the original function bytes" },
    "result": { "enum": ["identical", "differs", "error", "other"] },
    "verdict": { "enum": ["identical", "equivalent", "differs", "unchecked", "other"] },
    "instructions_differing": { "type": "integer", "minimum": 0 },
    "bytes_differing": { "type": "integer", "minimum": 0 },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "diagnosis": { "type": "array", "items": { "type": "string" } },
    "archive": { "type": "string" }
  },
  "additionalProperties": true
}
