{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge/references.toml",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "reference": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "jump, call; other ids are carried over unchanged"
          },
          "source": {
            "type": "string",
            "description": "human, agent, signature, runtime, similarity, analysis, import"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
