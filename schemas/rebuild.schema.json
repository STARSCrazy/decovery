{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge/rebuild.toml",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "function": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address",
          "name"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "compiler": {
            "type": "string"
          },
          "flags": {
            "type": "string"
          },
          "result": {
            "enum": [
              "identical",
              "differs",
              "error"
            ],
            "description": "Decomp's byte rule: identical when no byte and no reference differs"
          },
          "verdict": {
            "enum": [
              "identical",
              "equivalent",
              "differs",
              "unchecked"
            ],
            "description": "decovery's verdict"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "at": {
                  "type": "integer",
                  "minimum": 0
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "message": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "equal": {
            "type": "integer",
            "minimum": 0
          },
          "gaps": {
            "type": "integer",
            "minimum": 0
          },
          "differing": {
            "type": "integer",
            "minimum": 0
          },
          "refs_ok": {
            "type": "integer",
            "minimum": 0
          },
          "refs_wrong": {
            "type": "integer",
            "minimum": 0
          },
          "refs_unchecked": {
            "type": "integer",
            "minimum": 0
          },
          "instructions_differing": {
            "type": "integer",
            "minimum": 0
          },
          "alignment": {
            "type": "integer",
            "minimum": 0
          },
          "padding_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "date": {
            "type": "string"
          },
          "first_difference": {
            "type": "integer",
            "minimum": 0
          },
          "diagnoses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code_hash": {
            "type": "string",
            "description": "blake3 of the function's bytes in the object, 16 hex characters"
          },
          "equivalence": {
            "type": "object",
            "properties": {
              "verdict": {
                "enum": [
                  "unchecked",
                  "equivalent_tested",
                  "equivalent_proven"
                ]
              },
              "static": {
                "enum": [
                  "different",
                  "unclear",
                  "registers_only"
                ]
              },
              "static_reason": {
                "type": "string"
              },
              "dynamic": {
                "enum": [
                  "no_case",
                  "equal"
                ]
              },
              "cases": {
                "type": "integer",
                "minimum": 0
              },
              "genuine": {
                "type": "integer",
                "minimum": 0
              },
              "reliable": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "code": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
